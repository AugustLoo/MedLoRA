data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep
*.safetensors
*.bin
*.pt

__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
wandb/
.DS_Store
Thumbs.db

# 传给服务器的临时代码包
*-update.tar.gz
medlora-code.tar.gz

